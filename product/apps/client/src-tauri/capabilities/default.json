{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local workbench; no shell or arbitrary filesystem plugin permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://iba-world.com/*"
        },
        {
          "url": "https://www.thecocktaildb.com/*"
        },
        {
          "url": "https://github.com/UNKNOWNTIMER"
        },
        {
          "url": "https://github.com/UNKNOWNTIMER/programmer-mixology"
        }
      ]
    },
    "core:window:allow-show",
    "core:window:allow-destroy",
    "core:window:allow-set-title"
  ]
}
